{
  "name": "@bicou/directus-extension-tiptap",
  "description": "Tiptap rich text editor interface and display for directus",
  "icon": "extension",
  "version": "1.18.6",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-custom-bundle",
    "directus-custom-interface",
    "directus-custom-display",
    "tiptap",
    "prosemirror",
    "wysiwg",
    "editor"
  ],
  "homepage": "https://github.com/gbicou/directus-extension-tiptap",
  "author": "Benjamin VIELLARD <bicou@bicou.com>",
  "license": "MIT",
  "repository": "github:gbicou/directus-extension-tiptap",
  "type": "module",
  "directus:extension": {
    "host": "^12.0.0",
    "type": "bundle",
    "path": {
      "app": "dist/app.mjs",
      "api": "dist/api.mjs"
    },
    "entries": [
      {
        "type": "interface",
        "name": "directus-extension-tiptap-interface",
        "source": "src/interface.ts"
      },
      {
        "type": "display",
        "name": "directus-extension-tiptap-display",
        "source": "src/display.ts"
      }
    ]
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-character-count": "3.31.3",
    "@tiptap/extension-emoji": "3.31.3",
    "@tiptap/extension-focus": "3.31.3",
    "@tiptap/extension-highlight": "3.31.3",
    "@tiptap/extension-invisible-characters": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-mathematics": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-subscript": "3.31.3",
    "@tiptap/extension-superscript": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-table-cell": "3.31.3",
    "@tiptap/extension-table-header": "3.31.3",
    "@tiptap/extension-table-row": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/extension-text-style": "3.31.3",
    "@tiptap/extension-typography": "3.31.3",
    "@tiptap/extension-underline": "3.31.3",
    "@tiptap/extension-unique-id": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/suggestion": "3.31.3",
    "katex": "0.16.22"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "18.1.1",
    "@directus/schema": "14.0.2",
    "@directus/sdk": "27.1.0",
    "@directus/types": "18.1.0",
    "@eslint/js": "9.29.0",
    "@tiptap/vue-3": "3.31.3",
    "@vue/tsconfig": "0.7.0",
    "dotenv": "16.5.0",
    "eslint": "9.29.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-vue": "10.2.0",
    "prettier": "3.6.2",
    "sass": "1.89.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.0",
    "vitest": "3.2.4",
    "vue": "3.5.43",
    "vue-i18n": "11.4.17"
  },
  "peerDependencies": {
    "@directus/extensions-sdk": "18.1.1",
    "vue": "3.5.43",
    "vue-i18n": "11.4.17"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.18.2+sha512.9fb969fa749b3ade6035e0f109f0b8a60b5d08a1a87fdf72e337da90dcc93336e2280ca4e44f2358a649b83c17959e9993e777c2080879f3801e6f0d999ad3dd",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "vue-demi"
    ],
    "overrides": {
      "@tiptap/extension-bubble-menu": "3.31.3",
      "@tiptap/extension-floating-menu": "3.31.3"
    }
  },
  "overrides": {
    "@tiptap/extension-bubble-menu": "3.31.3",
    "@tiptap/extension-floating-menu": "3.31.3"
  }
}
